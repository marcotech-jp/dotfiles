alias ls='ls --color=auto'
alias ll='ls -alF'
alias la='ls -A'
alias cp='cp -i'
alias mv='mv -i'
alias rm='rm -i'

#---------------- git ----------------------------------#
alias g='git'
alias ga='git add'
alias gc='git checkout'
alias gs='git status -sb'
alias gst='git status'
alias gl='git log --graph --all --decorate --pretty=format:"[%cn](%cd)%d %s" --date=short'
alias ghv='gh repo view --web'

alias python="python3"
alias py="python3"
alias pip="pip3"

alias d='docker'
alias docker-compose='docker compose'
alias dc='docker compose'

alias tf='terraform'

alias ..='cd ..'

alias h='cd ~/${home}'

# AI tools
alias cx='codex'
alias cxr='codex resume'
alias cc='claude'
alias ccu='ccusage'

# IP addresses
alias gip="dig +short myip.opendns.com @resolver1.opendns.com"
# alias lip="ipconfig getifaddr en0" # en0 is the default interface on macOS

if [[ $(command -v bat) ]]; then
  alias cat='bat'
fi

alias c='code .'
alias t='tmux attach || tmux new'

alias v=vi
if [[ $(command -v vim) ]]; then
  alias vi=vim
fi
if [[ $(command -v nvim) ]]; then
  alias vim=nvim
fi

if [[ $(command -v eza) ]]; then
  alias ei="eza --git"
  alias ea="eza -la --icons --git"
  alias ee="eza -aahl --icons --git"
  alias et="eza --tree --icons -a -I 'node_modules|.git|.cache'"
  alias ls=ei
  alias la=ea
  alias ll=ee
  alias tree="eza --tree --icons"
fi

if [[ "$OSTYPE" == "darwin"* ]]; then
  alias no-sleep='caffeinate -i -d'
fi
